# Documentation example only. The application does not load .env files.
# Export these values in your shell or use the systemd EnvironmentFile.
TV_HOST=198.51.100.20
TV_PORT=8002
TV_CLIENT_NAME="Smart TV Remote"
# Optional HTTPS/WSS, loaded from the service environment (not this example).
# Both paths are required; keep the private key readable only by the service user.
# SMART_TV_TLS_CERT=/home/USER/.config/smart-tv/tls/screen-share.crt
# SMART_TV_TLS_KEY=/home/USER/.config/smart-tv/tls/screen-share.key
# Optional independent iPhone HTTPS 8769 / WSS 8770, signed by a local CA.
# All three paths are required. Export only the root certificate in the profile.
# SMART_TV_IOS_TLS_CERT=/home/USER/.config/smart-tv/tls/iphone/server-chain.crt
# SMART_TV_IOS_TLS_KEY=/home/USER/.config/smart-tv/tls/iphone/server.key
# SMART_TV_IOS_PROFILE=/home/USER/.config/smart-tv/tls/iphone/iphone.mobileconfig

# Enable only after signing, installing and validating tv-receiver on the TV.
# SMART_TV_TIZEN_RECEIVER=1
