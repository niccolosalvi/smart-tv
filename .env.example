# Documentation example only. The application does not load .env files.
# Export these values in your shell or use the systemd EnvironmentFile.
TV_HOST=198.51.100.20
TV_PORT=8002
TV_CLIENT_NAME="Smart TV Remote"
# Optional HTTPS/WSS, loaded from the service environment (not this example).
# Both paths are required; keep the private key readable only by the service user.
# SMART_TV_TLS_CERT=/home/USER/.config/smart-tv/tls/screen-share.crt
# SMART_TV_TLS_KEY=/home/USER/.config/smart-tv/tls/screen-share.key
